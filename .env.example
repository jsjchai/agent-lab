# 复制为 .env 后填入真实值；.env 已在 .gitignore 中
# 只填你实际会用到的，用不上的留着注释即可

# OpenAI / OpenAI 兼容
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=

# 本地模型（Ollama / vLLM）
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# 观测与追踪（可选）
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
